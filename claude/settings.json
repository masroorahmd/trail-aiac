{
  "enabledMcpjsonServers": [
    "plane"
  ],
  "outputStyle": "Plain",
  "permissions": {
    "allow": [
      "Edit(.claude/context/*.md)",
      "Edit(.claude/agent-memory/**)",
      "Edit(design/**)",
      "Edit(content/**)",
      "Edit(copy/**)",
      "Edit(posts/**)",
      "Edit(blog/**)",
      "Edit(public/**)",
      "Edit(src/content/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "p=$(cat); case \"$p\" in *commit*) [ -f .claude/hooks/commit-msg-guard.py ] && printf %s \"$p\" | python3 .claude/hooks/commit-msg-guard.py || true ;; esac",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__plane__.*",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f .claude/hooks/plane-persona-guard.py ] && python3 .claude/hooks/plane-persona-guard.py || true",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -f .claude/hooks/persona-pin.py ] && python3 .claude/hooks/persona-pin.py || true",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --with httpx --with pyyaml python3 .claude/skills/plane-id-cache/refresh.py >/dev/null 2>&1 || true",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
