{
  "enabledMcpjsonServers": ["plane"],
  "permissions": {
    "allow": [
      "Edit(.claude/context/*.md)",
      "Edit(.claude/agent-memory/**)",
      "Edit(content/**)",
      "Edit(copy/**)",
      "Edit(posts/**)",
      "Edit(blog/**)",
      "Edit(public/**)",
      "Edit(src/content/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --with httpx --with pyyaml python3 .claude/skills/plane-id-cache/refresh.py >/dev/null 2>&1 || true",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
