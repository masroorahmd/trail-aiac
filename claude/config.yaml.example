# Project configuration template for the Trail framework.
# Copy this file to `config.yaml` and fill in your values. `config.yaml` is
# gitignored; only this `.example` stub is safe to commit.
# Secrets live in credentials.yaml (also gitignored).

# Framework version. Recorded (with the framework git commit + a hash of
# every installed deliverable) into `<consumer>/.claude/trail-manifest.yaml`
# by `bin/install.py`, so a re-install knows which framework state produced
# the current files and can warn before overwriting a consumer-side edit.
framework:
  version: 0.1.0

# Language each persona uses when chatting with USER. The framework's
# *artefacts* — code, commits, Plane bodies + comments, files under
# `.claude/context/` and `.claude/agent-memory/`, the project's own
# source tree — are always in English (the framework targets an
# international audience). Only the USER↔persona dialogue is variable.
# Use a natural-language name in English, e.g. `English`, `German`,
# `French`, `Japanese`. Default: English.
chat_language: English

# USER's preferred first name, as agents should address you in chat.
# When set, every persona's operating-mode includes a bullet telling
# it to use your name when natural. Leave empty to keep agents from
# addressing you by name (they'll say 'you' / 'USER' instead).
user_name:

# Model lanes — which Claude model each tier of work runs on.
# bin/install.py substitutes these into the rendered persona and
# command files (they carry `__MODEL_STANDARD__` / `__MODEL_FULL__` /
# `__MODEL_CODEGEN__` placeholders). When a new model ships, bump the
# lane here and re-run bin/install.py — no framework edit needed.
#
#   standard — routine persona turns: ticket handover, implementation
#              lanes (BA, RE, BD, UD, TM, TW, RM, GM, MM).
#   full     — high-stakes, long-horizon reasoning: /sa design, /sr
#              threat review, and the edge-case-hunter subagent.
#   codegen  — volume code-writing subagents (ui-test-writer).
#
# Where these actually bind: only on real subagents (edge-case-hunter,
# ui-test-writer), which read the `model:` frontmatter of their agent
# file. A `/<persona>` turn runs in the MAIN LOOP and therefore on the
# session model — `/model` decides it, not this block. Keep the lanes
# equal to the model you run the session on, so a subagent never drops
# below the persona that spawned it.
model_lanes:
  standard: claude-opus-5
  full: claude-opus-5
  codegen: claude-opus-5

# Reading budget. Two thirds of a mature repository's bytes sit in a
# quarter of its files, and a persona that opens one of those whole
# spends most of the read on code it will not touch. Every persona (and
# `/quick`, and `/kickoff`) carries the shared `reading`
# rule; these three numbers are what it states. bin/install.py
# substitutes them as `__LARGE_FILE_LINES__` / `__LARGE_FILE_KB__` /
# `__HEAD_LINES__`.
#
#   large_file_lines — at or under this, read the whole file; above it,
#                      read the head and then the symbol. Lower it for a
#                      repo of small modules, raise it for one whose
#                      files are large by convention.
#   large_file_kb    — the same threshold in bytes, and it is live at the
#                      same time. A line is not a unit of size: the prose
#                      files a persona maintains (context cores, agent
#                      memory, design notes) are written one paragraph
#                      per line, so a 500-line file can carry 100 KB and
#                      clear the line threshold without being small.
#   head_lines       — how much of the top counts as "the head": module
#                      docstring plus imports, where a codebase states
#                      invariants that bind code far below. This read is
#                      mandatory, not advisory — it is the mitigation
#                      for the narrower field of view.
#
#   comment_full_bytes / comment_head_bytes — the same budget for the
#                      other thing every persona reads on every turn: a
#                      Plane comment thread. A pickup step names ONE
#                      comment ("read SR's findings"), but the only way
#                      to reach it is `list_comments`, which returns the
#                      whole thread. So the MCP server sends comments as
#                      plain text and cuts a body over `full_bytes` down
#                      to `head_bytes`, flagged `truncated`; the persona
#                      then calls `retrieve_comment` for the one it
#                      needs. Trail's comment convention puts the author
#                      and artefact kind on the first line ("Security
#                      review (security-reviewer)"), which is what makes
#                      a head of a few hundred bytes selectable. Measured
#                      on a real nine-comment thread: 19.8k tokens raw,
#                      2.0k condensed.
reading:
  large_file_lines: 400
  large_file_kb: 40
  head_lines: 60
  comment_full_bytes: 2000
  comment_head_bytes: 600

# Hooks — the rules the harness enforces instead of the prompt asking.
# A rule that is mechanically checkable is the wrong thing to spend
# prompt tokens on: `claude/hooks/` holds the check, `settings.json`
# wires it, and the persona prompt keeps only the reasoning a check
# cannot teach. This block is where a consumer says how hard each one
# holds — `settings.json` itself is a copied deliverable, overwritten on
# every install.py run, so a preference expressed there would not
# survive. (A future hook whose *wiring* must vary — a different event
# or matcher — would need install.py to render settings.json; today
# every knob is read by the hook script at run time.)
#
#   commit_id_required — how the commit-subject guard behaves when a
#                        persona runs `git commit`. The rule it enforces
#                        lives in `claude/partials/commit-message.md`:
#                        the work-item ID is the first token of the
#                        subject line.
#
#     plane-only  Deny only when the message names a work-item ID that
#                 is not leading the subject — the ID buried in the body
#                 or in a `Refs:` trailer. A commit that names no ID at
#                 all passes: `/quick` is the framework's off-Plane lane
#                 and is told never to invent one, so a blanket rule
#                 would force exactly the invention the prompt forbids.
#                 This is the default, and it catches the failure that
#                 actually happens.
#     strict      Every commit subject must open with an ID. For projects
#                 where all work is ticketed and an ID-less commit is
#                 always a mistake. The escape hatch for the genuine
#                 exception is to prefix the command with
#                 TRAIL_SKIP_COMMIT_GUARD=1 — deliberate and visible in
#                 the transcript, unlike a made-up ID.
#     off         No check.
#
#   In both live modes an ID whose prefix is not one of the `projects:`
#   identifiers below is denied as a typo, since a wrong ID is a worse
#   bridge than no ID.
#
#   persona_identity — every Plane MCP tool takes a `persona` argument
#                      naming who authors the call. This checks it
#                      against the `/<persona>` command USER actually
#                      started (recorded by `persona-pin.py`), so a
#                      write cannot land under the wrong Plane account.
#                      The identity used to live in the tool *name* —
#                      one full tool set per persona, 286 schemas in
#                      every session's system prompt — to express a
#                      constraint nothing ever checked. This is that
#                      constraint, checked, at a tenth of the tokens.
#
#     strict      Deny the mismatch. A persona's role ends when USER
#                 starts a different `/<persona>`, so a call under
#                 another name is a bug in every case the guard can see.
#                 Default.
#     ask         Put the mismatch to USER as a permission prompt.
#     off         No check.
#
#   Every uncertain case passes: a session with no `/<persona>` yet, a
#   multi-persona lane (`/autopilot`, `/quick`, `/kickoff`). A missed
#   check costs one wrongly-attributed comment; a false deny stops work
#   USER asked for. Parallel sessions are unaffected — the pin lives at
#   `.claude/cache/persona/<session-id>.json`, one per session, so `/ba`
#   in one terminal and `/tm` in another are each checked against their
#   own role.
hooks:
  commit_id_required: plane-only
  persona_identity: strict

# Autopilot — the unattended lane (`/autopilot DEV-N`). One human-
# initiated turn drives an already-framed Story — or every Story in a
# work-item tree above it (Epic → Story → module children, nested to
# any depth) — through the whole engineering spine (RE → SA → SR →
# BD/UD → TM → TM review run → SR-diff → TW → commit → RM → hand back)
# with no human in the
# loop: personas make + log reasonable assumptions instead of asking,
# and the orchestrator owns git — the implementors run one at a time
# directly in the feature tree (never concurrently, never in a
# worktree). It creates ONE feature branch per Story, shared by that
# Story's module children, and it NEVER merges and NEVER deletes a
# branch: every branch is pushed and left standing, and every Story
# (then every container above it) is handed back `In Review` +
# assigned to USER with step-by-step review steps. USER merges
# and USER closes; rework goes back into the same ticket on the same
# branch. It is deliberately the NARROW lane — it stops and hands back
# the moment a change leaves the risk lane (a hard security finding, a
# migration, a new external contract, a new dependency, or irreducible
# ambiguity).
#
#   enabled               — master switch. `/autopilot` refuses to run
#                           unless this is true. Default off: opt in per
#                           project once you trust the lane.
#   max_repair_iterations — how many times TM↔implementor may loop to
#                           turn a red suite green (or to fix a defect the
#                           review run found) before autopilot stops. One
#                           shared budget per Story across the TM, review-run
#                           and SR-diff repair loops.
#   review_run            — after TM's green pass, have TM DRIVE the review
#                           steps it just wrote against the running app
#                           (browser for UI steps, plain commands for
#                           curl/CLI ones) instead of only writing them down.
#                           Findings are triaged: back to the owning persona
#                           as a rework round, fixed in TM's own slice, or —
#                           when the fix is too large for the slice — filed
#                           as a `Follow-up: …` work-item that rides the
#                           hand-back. Needs a driver the project can reach:
#                           its own browser/e2e harness (best), or a
#                           DOM/accessibility-tree browser MCP wired at USER
#                           scope. With none, TM reports the steps as
#                           un-driven and the run continues. Set false to
#                           turn the stage off for projects with no
#                           executable surface worth driving. Default true.
#                           For a one-off run without the Test Manager at
#                           all — suite gate AND review run — pass
#                           `/autopilot DEV-N --no-tm` instead of editing
#                           this file: config is "not here", the flag is
#                           "not this time". `--no-review-run` is the
#                           narrower per-run twin of this key — TM still
#                           writes tests and steps, nobody drives them.
#   max_risk_lane         — the highest risk tier autopilot may carry on
#                           its own (`standard`). Anything the personas
#                           judge above this is handed back to a human.
#   lean_lane             — let the orchestrator use judgement to trim the
#                           ceremony: skip RE / SA / SR / TM / TW or RM's
#                           release ceremony when they add no value for
#                           this Story, and collapse or swap the BD/UD
#                           implementors (one agent covers both slices, or
#                           a slice is routed to the other discipline) when
#                           the cross-over work is small. Every skip is
#                           logged as a `SKIP-N` decision and reported.
#                           Hard floors always hold: SR still runs whenever
#                           the change touches a security non-negotiable
#                           (CM-N), and RM's HAND-BACK never skips — a
#                           Story always reaches USER `In Review` with its
#                           review steps. Set false to force the full
#                           spine every run (compliance-heavy projects).
#                           Default true.
# Autopilot — the unattended lane.
#
#   max_repair_iterations — how many repair rounds the shared budget
#                     allows across TM's suite gate, the review run and
#                     SR's diff pass. Still a cap on rounds USER
#                     *approves* when the gates below are on.
#   approval        — the two moments that are not a continuation of the
#                     run but the start of a new one, and where the cost
#                     of an unattended run actually accumulates. With
#                     these on, autopilot's forward path stays
#                     hands-off and only *re-entry* needs a word from
#                     USER — it ends its turn with a decision box and
#                     resumes in the same thread, keeping everything it
#                     has already read.
#
#     repair_rounds Pause before re-entering a stage that already
#                   finished (TM's red suite, a review-run defect, an
#                   SR-diff finding). One round is an implementor plus a
#                   TM re-run plus, at SR, an SR re-run — three cold
#                   subagents that each re-read the ticket. Hard gates
#                   (SR blocker/high, a violated CM-N, an app that will
#                   not boot) are never a pause: they stay STOPs.
#     story_switch  Pause before starting the next Story of a
#                   multi-Story tree, so what the finished Story taught
#                   can still change what the next one does.
#
#                   Set both to `false` for the old fully-unattended
#                   behaviour: rounds run automatically up to the budget.
autopilot:
  enabled: false
  max_repair_iterations: 2
  max_risk_lane: standard
  lean_lane: true
  review_run: true
  approval:
    repair_rounds: true
    story_switch: true

# Plane ticket system configuration. Any Plane deployment works — cloud or
# self-hosted. Tokens per agent go into credentials.yaml.
#
# `projects.{business,dev,hq}` are the Plane project IDENTIFIERS — the
# short prefix Plane embeds in work-item IDs (e.g. `DEV-1`, `BIZ-7`,
# `HQ-3`). Visible in the Plane UI under Project Settings → General →
# Identifier. The Ansible turn-key install (see ansible/README.md)
# creates these projects with these identifiers.
plane:
  base-url: https://plane.example.com    # your Plane URL, no trailing slash
  workspace: example                      # workspace slug (URL fragment, lowercase)
  projects:
    business: BIZ                         # Business Analyst's strategy/research notebook
    dev:      DEV                         # main development project (every engineering persona)
    hq:       HQ                          # General Manager's operational track (Behörden, Recht, Förderung, …)
    mkt:      MKT                         # Marketing Manager's website + brand + SEO track (OSS narrative + EE sales funnel)

# Agent identities. The `email` field is each agent's Plane workspace login.
# Replace `example.com` with your own domain (or use whatever email addresses
# your Plane users were registered with). Display names and avatars can be
# customised; keep the top-level agent keys (the "username") intact since
# they are referenced across the framework.
agents:
  general-manager:
    full-name: General Manager
    email: general-manager@example.com
    gender: male
    avatar: avatars/general-manager.png
  business-analyst:
    full-name: Business Analyst
    email: business-analyst@example.com
    gender: male
    avatar: avatars/business-analyst.png
  requirements-engineer:
    full-name: Requirements Engineer
    email: requirements-engineer@example.com
    gender: male
    avatar: avatars/requirements-engineer.png
  software-architect:
    full-name: Software Architect
    email: software-architect@example.com
    gender: male
    avatar: avatars/software-architect.png
  security-reviewer:
    full-name: Security Reviewer
    email: security-reviewer@example.com
    gender: male
    avatar: avatars/security-reviewer.png
  backend-developer:
    full-name: Backend Developer
    email: backend-developer@example.com
    gender: male
    avatar: avatars/backend-developer.png
  ui-developer:
    full-name: UI Developer
    email: ui-developer@example.com
    gender: male
    avatar: avatars/ui-developer.png
  test-manager:
    full-name: Test Manager
    email: test-manager@example.com
    gender: female
    avatar: avatars/test-manager.png
  technical-writer:
    full-name: Technical Writer
    email: technical-writer@example.com
    gender: female
    avatar: avatars/technical-writer.png
  release-manager:
    full-name: Release Manager
    email: release-manager@example.com
    gender: male
    avatar: avatars/release-manager.png
  marketing-manager:
    full-name: Marketing Manager
    email: marketing-manager@example.com
    gender: female
    avatar: avatars/marketing-manager.png
